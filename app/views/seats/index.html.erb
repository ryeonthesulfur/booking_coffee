<!-- ナビゲーション -->
<nav class="top-nav">
  <div class="top-nav__inner">
    <div class="top-nav__left">
      <span class="top-nav__logo">booking_coffee</span>
      <span class="top-nav__tagline">今日の気分にぴったりの席を見つけましょう</span>
    </div>
    <div class="top-nav__actions">
      <span class="top-nav__flag">🇯🇵</span>
      <% if user_signed_in? %>
        <%= link_to current_user.name, edit_user_registration_path, class: "top-nav__link" %>
        <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "top-nav__btn" %>
      <% else %>
        <%= link_to "登録", new_user_registration_path, class: "top-nav__btn" %>
        <%= link_to "ログイン", new_user_session_path, class: "top-nav__btn" %>
      <% end %>
    </div>
  </div>
</nav>

<!-- ヒーローセクション / 検索バー -->
<header class="top-header">
  <div class="top-inner">

    <div class="top-cta">
      <h2 class="top-cta__heading">会員限定であなたの居場所を<br>お得に予約</h2>
      <p class="top-cta__subtext">"気持ちいっぱいフリーキャンペーン" 実施中！<br>全店舗、予約したらコーヒー全種１杯フリー！</p>
      <%= link_to "ログインまたは新規登録", new_user_session_path, class: "top-cta__btn" %>
    </div>

    <div class="search-bar">
      <div class="search-field">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <input type="text" id="date-input" placeholder="いつ利用しますか？" readonly />
      </div>
      <div class="search-field search-field--narrow">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <select class="num-select">
          <option value="" disabled selected>人数</option>
          <% (1..6).each do |n| %>
            <option value="<%= n %>"><%= n %>名</option>
          <% end %>
        </select>
      </div>
      <button class="search-submit">席を探す</button>
    </div>


    <div class="search-sub-row">
      <div id="filter-buttons" class="filter-buttons filter-buttons--hero">
        <button data-category="すべて" class="filter-btn filter-btn--active">すべて</button>
        <button data-category="コンセント" class="filter-btn">カウンター</button>
        <button data-category="ソファ" class="filter-btn">テーブル</button>
        <button data-category="テラス" class="filter-btn">テラス</button>
      </div>
      <span style= "color: white;">／</span>
      <div class="smoking-filters">
        <label class="search-filter-item">
          <input type="checkbox" name="smoking[]" value="non_smoking" />
          禁煙
        </label>
        <label class="search-filter-item">
          <input type="checkbox" name="smoking[]" value="smoking" />
          喫煙
        </label>
      </div>
    </div>
  </div>
</header>

<!-- 席一覧セクション -->
<main class="seats-section">
  <div class="seats-header">
    <h2 class="seats-heading">人気の喫茶店</h2>
  </div>

  <div class="seats-carousel">
    <button class="seats-carousel__btn seats-carousel__btn--left" id="carousel-btn-left">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>

    <div class="seats-carousel__viewport">
      <div class="seats-carousel__track" id="carousel-track">
        <% seats.each do |s| %>
          <%= render "seat_card", **s %>
        <% end %>
      </div>
    </div>

    <button class="seats-carousel__btn seats-carousel__btn--right" id="carousel-btn-right">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </div>
</main>

<!-- 週末セールセクション -->
<section class="sale-section">
  <div class="sale-section__inner">
    <div class="seats-header">
      <h2 class="seats-heading">週末はさらにお得</h2>
    </div>
    <div class="sale-grid">
      <% sale_seats.each do |s| %>
        <%= render "sale_card", **s %>
      <% end %>
    </div>
  </div>
</section>
