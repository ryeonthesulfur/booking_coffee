<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ja.js"></script>
<% end %>

<!-- ナビゲーション -->
<nav class="top-nav">
  <div class="top-nav__inner">
    <div class="top-nav__left">
      <span class="top-nav__logo">booking_coffee</span>
      <span class="top-nav__tagline">今日の気分にぴったりの席を見つけましょう</span>
    </div>
    <div class="top-nav__actions">
      <span class="top-nav__flag">🇯🇵</span>
      <% if user_signed_in? %>
        <%= link_to current_user.name, edit_user_registration_path, class: "top-nav__link" %>
        <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "top-nav__btn" %>
      <% else %>
        <%= link_to "登録", new_user_registration_path, class: "top-nav__btn" %>
        <%= link_to "ログイン", new_user_session_path, class: "top-nav__btn" %>
      <% end %>
    </div>
  </div>
</nav>

<!-- ヒーローセクション / 検索バー -->
<header class="top-header">
  <div class="top-inner">

    <div class="top-cta">
      <h2 class="top-cta__heading">会員限定であなたの居場所を<br>お得に予約</h2>
      <%= link_to "ログインまたは新規登録", new_user_session_path, class: "top-cta__btn" %>
    </div>

    <div class="search-bar">
      <div class="search-field">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <input type="text" id="date-input" placeholder="いつ利用しますか？" readonly />
      </div>
      <div class="search-field search-field--narrow">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <input type="number" placeholder="人数" />
      </div>
      <button class="search-submit">席を探す</button>
    </div>
  </div>
</header>

<!-- 席一覧セクション -->
<main class="seats-section">
  <div class="seats-header">
    <h2 class="seats-heading">おすすめの席</h2>
    <div id="filter-buttons" class="filter-buttons">
      <button data-category="すべて" class="filter-btn filter-btn--active">すべて</button>
      <button data-category="コンセント" class="filter-btn">コンセント</button>
      <button data-category="ソファ" class="filter-btn">ソファ</button>
      <button data-category="テラス" class="filter-btn">テラス</button>
    </div>
  </div>

  <div class="seats-grid">

    <!-- Seat Card 1 -->
    <div class="seat-card">
      <div class="seat-card__image" style="background-image: url('https://images.unsplash.com/photo-1559925393-8be0ec4767c8?q=80&w=2070&auto=format&fit=crop');">
        <div class="seat-card__overlay"></div>
        <div class="seat-card__tags">
          <span class="seat-card__tag">集中</span>
          <span class="seat-card__tag">静か</span>
        </div>
      </div>
      <div class="seat-card__body">
        <div class="seat-card__top">
          <div>
            <h3 class="seat-card__name">席番号 A-101</h3>
            <p class="seat-card__desc">窓際・コンセント有</p>
          </div>
          <div class="seat-card__price">
            <span class="seat-card__price-value">¥500</span>
            <span class="seat-card__price-unit">/ 1時間</span>
          </div>
        </div>
        <div class="seat-card__meta-row">
          <div class="seat-card__meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            最大2名
          </div>
          <div class="seat-card__meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            予約可
          </div>
        </div>
        <button class="seat-card__reserve">
          この席を予約する
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <!-- Seat Card 2 -->
    <div class="seat-card">
      <div class="seat-card__image" style="background-image: url('https://images.unsplash.com/photo-1554118811-1e0d58224f24?q=80&w=2047&auto=format&fit=crop');">
        <div class="seat-card__overlay"></div>
        <div class="seat-card__tags">
          <span class="seat-card__tag">談笑</span>
          <span class="seat-card__tag">ゆったり</span>
        </div>
      </div>
      <div class="seat-card__body">
        <div class="seat-card__top">
          <div>
            <h3 class="seat-card__name">席番号 B-204</h3>
            <p class="seat-card__desc">ソファ席</p>
          </div>
          <div class="seat-card__price">
            <span class="seat-card__price-value">¥800</span>
            <span class="seat-card__price-unit">/ 1時間</span>
          </div>
        </div>
        <div class="seat-card__meta-row">
          <div class="seat-card__meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            最大4名
          </div>
          <div class="seat-card__meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            予約可
          </div>
        </div>
        <button class="seat-card__reserve">
          この席を予約する
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <!-- Seat Card 3 -->
    <div class="seat-card">
      <div class="seat-card__image" style="background-image: url('https://images.unsplash.com/photo-1453614512568-c4024d13c247?q=80&w=1932&auto=format&fit=crop');">
        <div class="seat-card__overlay"></div>
        <div class="seat-card__tags">
          <span class="seat-card__tag">読書</span>
          <span class="seat-card__tag">短時間</span>
        </div>
      </div>
      <div class="seat-card__body">
        <div class="seat-card__top">
          <div>
            <h3 class="seat-card__name">席番号 C-301</h3>
            <p class="seat-card__desc">カウンター席</p>
          </div>
          <div class="seat-card__price">
            <span class="seat-card__price-value">¥400</span>
            <span class="seat-card__price-unit">/ 1時間</span>
          </div>
        </div>
        <div class="seat-card__meta-row">
          <div class="seat-card__meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            最大1名
          </div>
          <div class="seat-card__meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            予約可
          </div>
        </div>
        <button class="seat-card__reserve">
          この席を予約する
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>

  </div>
</main>

<script>
  flatpickr("#date-input", {
    enableTime: true,
    dateFormat: "Y年m月d日 H:i",
    locale: "ja",
    minDate: "today",
    time_24hr: true,
    minuteIncrement: 30
  });

  const filterContainer = document.getElementById('filter-buttons');
  const filterBtns = filterContainer.querySelectorAll('.filter-btn');

  filterContainer.addEventListener('click', (event) => {
    const clicked = event.target.closest('.filter-btn');
    if (!clicked) return;

    filterBtns.forEach(btn => btn.classList.remove('filter-btn--active'));
    clicked.classList.add('filter-btn--active');

    const selected = clicked.dataset.category;
    console.log('選択されたカテゴリ:', selected);
  });
</script>
