<div class="auth-wrapper">
  
  <div class="auth-header">
    <h1>booking_coffee</h1>
    <p>アカウントを作成して、あなたの居場所を確保しましょう。</p>
  </div>

  <div class="auth-card">
    <h2>新規会員登録</h2>

    <%= form_with(model: resource, url: registration_path(resource_name), local: true) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="form-space">
        <div class="field">
          <%= f.label :name, "氏名", class: "auth-label" %>
          <%= f.text_field :name, autofocus: true, class: "auth-input" %>
        </div>

        <div class="field">
          <%= f.label :email, "メールアドレス", class: "auth-label" %>
          <%= f.email_field :email, autocomplete: "email", class: "auth-input" %>
        </div>

        <div class="field">
          <div class="label-row">
            <%= f.label :password, "パスワード", class: "auth-label", style: "margin-bottom: 0;" %>
            <% if @minimum_password_length %>
              <span class="label-hint">(<%= @minimum_password_length %>文字以上)</span>
            <% end %>
          </div>
          <%= f.password_field :password, autocomplete: "new-password", class: "auth-input" %>
        </div>

        <div class="field">
          <%= f.label :password_confirmation, "パスワード（確認用）", class: "auth-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "auth-input" %>
        </div>

        <div class="actions" style="padding-top: 0.5rem;">
          <%= f.submit "登録する", class: "btn-submit" %>
        </div>
      </div>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>