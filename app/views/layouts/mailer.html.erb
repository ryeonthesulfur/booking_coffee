<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
      /* モバイル用のフォントや微調整（念のためのバックアップ） */
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }
    </style>
  </head>

  <body style="margin: 0; padding: 0; width: 100% !important; background-color: #f5f5f4; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%;">
    
    <div style="width: 100%; background-color: #f5f5f4; padding: 40px 20px; box-sizing: border-box;">
      <div style="max-w: 540px; margin: 0 auto;">
        
        <div style="text-align: center; margin-bottom: 24px;">
          <h1 style="font-size: 24px; font-weight: 900; color: #1c1917; margin: 0; letter-spacing: -0.025em;">
            booking_coffee
          </h1>
        </div>

        <div style="background-color: #ffffff; border: 1px solid #e7e5e4; border-radius: 16px; padding: 32px; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);">
          
          <div style="font-size: 14px; line-height: 1.6; color: #44403c;">
            <%= yield %>
          </div>

        </div>

        <div style="text-align: center; margin-top: 24px;">
          <p style="font-size: 11px; color: #78716c; margin: 0;">
            ※このメールは booking_coffee より自動配信されています。
          </p>
        </div>

      </div>
    </div>

  </body>
</html>