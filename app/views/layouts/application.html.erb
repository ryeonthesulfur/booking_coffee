<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Booking Coffee" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Booking Coffee">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Noto+Serif+JP:wght@700;900&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "devise_style" %>
    <%= stylesheet_link_tag "top_view" %>
    <%= stylesheet_link_tag "store_intro" %>
    <%= stylesheet_link_tag "store_floor_common" %>
    <%= yield :store_css %>
    <%= stylesheet_link_tag "reservation_form" %>
    <%= stylesheet_link_tag "confirm" %>
    <%= stylesheet_link_tag "complete" %>
    <%= stylesheet_link_tag "reservation_info" %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div id="flash" data-turbo-temporary>
      <% if flash[:alert] %>
        <div style="font-size: 0.75rem; color: #dc2626; background-color: #fef2f2; padding: 0.5rem 0.75rem; border-radius: 0.5rem; margin: 1rem auto; max-width: 28rem;">
          <%= flash[:alert] %>
        </div>
      <% end %>
      <% if flash[:notice] %>
        <div style="font-size: 0.75rem; color: #15803d; background-color: #f0fdf4; padding: 0.5rem 0.75rem; border-radius: 0.5rem; margin: 1rem auto; max-width: 28rem;">
          <%= flash[:notice] %>
        </div>
      <% end %>
    </div>

    <!-- ナビゲーション -->
<nav class="top-nav">
  <div class="top-nav__inner">
    <div class="top-nav__left">
        <%= link_to "booking ☕️ coffee", root_path, class: "top-nav__logo"%>
      <span class="top-nav__tagline">今日の気分にぴったりの席を見つけましょう</span>
    </div>
    <div class="top-nav__actions">
      <span class="top-nav__flag">🇯🇵</span>
      <% if user_signed_in? %>
        <%= link_to "予約一覧", reservations_path, class: "top-nav__link" %>
        <%= link_to current_user.name, edit_user_registration_path, class: "top-nav__link" %>
        <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "top-nav__btn" %>
      <% else %>
        <%= link_to "登録", new_user_registration_path, class: "top-nav__btn" %>
        <%= link_to "ログイン", new_user_session_path, class: "top-nav__btn" %>
      <% end %>
    </div>
  </div>
</nav>

    <%= yield %>
  </body>
</html>
