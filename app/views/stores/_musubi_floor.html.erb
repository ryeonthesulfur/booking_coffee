３店舗<% content_for :store_css do %>
  <%= stylesheet_link_tag "store_floor_3" %>
<% end %>

<div class="floor-map-container">
  <% if confirm_mode %>
    <div class="floor-title">喫茶むすび - 座席確認</div>
  <% else %>
    <div class="floor-title">喫茶むすび - 座席選択</div>
  <% end %>

<% unless confirm_mode %>
  <div class="floor-subtitle">ご希望の座席をタップして予約に進んでください。</div>
<% end %>

  <div class="legend-area">
    <div class="legend-item">
      <div class="legend-color legend-color--available"></div>
      <span>空席</span>
    </div>
    <div class="legend-item">
      <div class="legend-color legend-color--selected"></div>
      <span>選択中</span>
    </div>
    <div class="legend-item">
      <div class="legend-color legend-color--reserved"></div>
      <span>予約済み</span>
    </div>
  </div>


    <div class="musubi-floor-plan">
      <div class="musubi-inner-floor"></div>

      <div class="floor-object floor-object-reception musubi-reception">受付</div>
      <div class="floor-object floor-object-entrance musubi-entrance">入り口</div>
      <div class="floor-object floor-object-wc musubi-wc">W.C.</div>

      <% reserved = @reserved_seat_numbers&.include?('C-1') %>
      <label class="seat-label musubi-seat-c1 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="C-1" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box musubi-circle">
          <span class="seat-num">テラス席</span>
          <span class="seat-info">C-1 / 4名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('C-2') %>
      <label class="seat-label musubi-seat-c2 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="C-2" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box musubi-circle">
          <span class="seat-num">テラス席</span>
          <span class="seat-info">C-2 / 4名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('C-3') %>
      <label class="seat-label musubi-seat-c3 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="C-3" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box musubi-circle">
          <span class="seat-num">テラス席</span>
          <span class="seat-info">C-3 / 4名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('B-1') %>
      <label class="seat-label musubi-seat-b1 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="B-1" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box">
          <span class="seat-num">テーブル席</span>
          <span class="seat-info">B-1 / 4名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('B-3') %>
      <label class="seat-label musubi-seat-b3 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="B-3" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box">
          <span class="seat-num">テーブル席</span>
          <span class="seat-info">B-3 / 4名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('B-5') %>
      <label class="seat-label musubi-seat-b5 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="B-5" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box">
          <span class="seat-num">テーブル席</span>
          <span class="seat-info">B-5 / 4名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('B-2') %>
      <label class="seat-label musubi-seat-b2 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="B-2" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box">
          <span class="seat-num">テーブル席</span>
          <span class="seat-info">B-2 / 4名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('B-4') %>
      <label class="seat-label musubi-seat-b4 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="B-4" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box">
          <span class="seat-num">テーブル席</span>
          <span class="seat-info">B-4 / 4名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('B-6') %>
      <label class="seat-label musubi-seat-b6 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="B-6" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box">
          <span class="seat-num">テーブル席</span>
          <span class="seat-info">B-6 / 4名</span>
        </div>
      </label>

    </div>

<% unless confirm_mode %>
    <div class="booking-action-area">
      <button type="button" data-store-id="<%= @store.id %>" class="btn-booking">選択した席で予約を進める</button>
    </div>
<% end %>

</div>