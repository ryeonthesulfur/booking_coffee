<% content_for :store_css do %>
  <%= stylesheet_link_tag "store_floor_2" %>
<% end %>

<div class="floor-map-container">
  <% if confirm_mode %>
  <div class="floor-title">蔵前喫茶店 - 座席確認</div>
  <% else %>
  <div class="floor-title">蔵前喫茶店 - 座席選択</div>
  <% end %>

  <% unless confirm_mode %>
  <div class="floor-subtitle">ご希望の座席をタップして予約に進んでください。</div>
  <% end %>

  <div class="legend-area">
    <div class="legend-item">
      <div style="width: 16px; height: 16px; background: #fff; border: 1px solid #b5b4b1; border-radius: 4px;"></div>
      <span>空席</span>
    </div>
    <div class="legend-item">
      <div style="width: 16px; height: 16px; background: #78350f; border-radius: 4px;"></div>
      <span>選択中</span>
    </div>
    <div class="legend-item">
      <div style="width: 16px; height: 16px; background: #d6d3d1; border-radius: 4px;"></div>
      <span>予約済み</span>
    </div>
  </div>

  
    <div class="kuramae-floor-plan">
      
      <div class="floor-object floor-object-counter object-counter-left">カ<br>ウ<br>ン<br>タ<br>┃<br>席</div>
      <div class="floor-object floor-object-counter object-counter-bottom">カウンター席</div>
      <div class="floor-object floor-object-reception kuramae-reception">受付</div>
      <div class="floor-object floor-object-entrance infra-entrance">入り口</div>
      <div class="floor-object floor-object-wc infra-wc">W.C.</div>

      <label class="seat-label seat-a5">
        <input type="radio" name="seat_id" value="A-5" class="seat-radio">
        <div class="seat-box">
          <span class="seat-num">A-5</span>
          <span class="seat-info">1名 / ¥550</span>
        </div>
      </label>

      <label class="seat-label seat-a6">
        <input type="radio" name="seat_id" value="A-6" class="seat-radio">
        <div class="seat-box">
          <span class="seat-num">A-6</span>
          <span class="seat-info">1名 / ¥550</span>
        </div>
      </label>

      <label class="seat-label seat-a7">
        <input type="radio" name="seat_id" value="A-7" class="seat-radio">
        <div class="seat-box">
          <span class="seat-num">A-7</span>
          <span class="seat-info">¥500</span>
        </div>
      </label>

      <div class="counter-seats-row">
        <label class="seat-label">
          <input type="radio" name="seat_id" value="A-1" class="seat-radio">
          <div class="seat-box">
            <span class="seat-num">A-1</span>
            <span class="seat-info">1名 / ¥550</span>
          </div>
        </label>

        <label class="seat-label">
          <input type="radio" name="seat_id" value="A-2" class="seat-radio">
          <div class="seat-box">
            <span class="seat-num">A-2</span>
            <span class="seat-info">1名 / ¥550</span>
          </div>
        </label>

        <label class="seat-label">
          <input type="radio" name="seat_id" value="A-3" class="seat-radio">
          <div class="seat-box">
            <span class="seat-num">A-3</span>
            <span class="seat-info">1名 / ¥550</span>
          </div>
        </label>

        <label class="seat-label">
          <input type="radio" name="seat_id" value="A-4" class="seat-radio">
          <div class="seat-box">
            <span class="seat-num">A-4</span>
            <span class="seat-info">1名 / ¥550</span>
          </div>
        </label>
      </div>

      <label class="seat-label seat-b1">
        <input type="radio" name="seat_id" value="B-1" class="seat-radio">
        <div class="seat-box">
          <span class="seat-num">テーブル席<br>(B-1)</span>
          <span class="seat-info">2名用<br>¥850/h</span>
        </div>
      </label>

      <label class="seat-label seat-b2">
        <input type="radio" name="seat_id" value="B-2" class="seat-radio">
        <div class="seat-box">
          <span class="seat-num">テーブル席<br>(B-2)</span>
          <span class="seat-info">4名用<br>¥1,200/h</span>
        </div>
      </label>

      <label class="seat-label seat-b3">
        <input type="radio" name="seat_id" value="B-3" class="seat-radio">
        <div class="seat-box">
          <span class="seat-num">テーブル席<br>(B-3)</span>
          <span class="seat-info">2名用<br>¥850/h</span>
        </div>
      </label>

    </div>

   <% unless confirm_mode %>
    <div class="booking-action-area">
      <button type="button" data-store-id="<%= @store.id %>" class="btn-booking">選択した席で予約を進める</button>
    </div>
   <% end %>

</div>