<!-- ヒーローセクション -->
<header class="top-header">
  <div class="top-inner">

    <div class="top-cta">
      <h2 class="top-cta__heading">会員限定であなたの居場所を<br>お得に予約</h2>
      <p class="top-cta__subtext">"気持ちいっぱいフリーキャンペーン" 実施中！<br>全店舗、予約したらコーヒー全種１杯フリー！</p>
      <% unless user_signed_in? %>
        <%= link_to "ログインまたは新規登録", new_user_session_path, class: "top-cta__btn" %>
      <% end %>
    </div>
  </div>
</header>

<!-- 店舗一覧セクション -->
<main class="stores-section">
  <div class="stores-header">
    <h2 class="stores-heading">人気の喫茶店</h2>
  </div>

    <div class="stores-viewport">
      <div class="stores-track" id="carousel-track">
        <% @stores.each do |store| %>
          <%= render partial: "store_card", locals: { store: store } %>
        <% end %>
      </div>
    </div>

  </div>
</main>


<%#「seat_card」を「store_card」に変更 %>