<% content_for :store_css do %>
  <%= stylesheet_link_tag "store_floor_1" %>
<% end %>

<div class="rondo-map-container">
  <div class="rondo-title">カフェ・ロンド - 座席選択</div>
  <div class="rondo-subtitle">ご希望の座席をタップして予約に進んでください。</div>

  <div class="rondo-legend-area">
    <div class="rondo-legend-item">
      <div style="width: 16px; height: 16px; background: #fff; border: 1px solid #b5b4b1; border-radius: 4px;"></div>
      <span>空席</span>
    </div>
    <div class="rondo-legend-item">
      <div style="width: 16px; height: 16px; background: #78350f; border-radius: 4px;"></div>
      <span>選択中</span>
    </div>
    <div class="rondo-legend-item">
      <div style="width: 16px; height: 16px; background: #d6d3d1; border-radius: 4px;"></div>
      <span>予約済み</span>
    </div>
  </div>

  <form action="#" method="get">
    <div class="rondo-floor-plan">
      <div class="rondo-inner-floor"></div>

      <div class="rondo-floor-object rondo-counter-top">カウンター席</div>
      <div class="rondo-floor-object rondo-reception">受付</div>
      <div class="rondo-floor-object floor-object-entrance rondo-entrance">入り口</div>
      <div class="rondo-floor-object floor-object-wc rondo-wc">W.C.</div>

      <label class="rondo-seat-label rondo-seat-c1">
        <input type="radio" name="seat_id" value="C-1" class="rondo-seat-radio">
        <div class="rondo-box-c1">
          <span class="rondo-seat-num">テラス席</span>
          <span class="rondo-seat-info">2名 / ¥900</span>
        </div>
      </label>

      <label class="rondo-seat-label rondo-seat-c2">
        <input type="radio" name="seat_id" value="C-2" class="rondo-seat-radio">
        <div class="rondo-box-c2">
          <span class="rondo-seat-num">テラス席</span>
          <span class="rondo-seat-info">4名 / ¥1,300</span>
        </div>
      </label>

      <label class="rondo-seat-label rondo-seat-b1">
        <input type="radio" name="seat_id" value="B-1" class="rondo-seat-radio">
        <div class="rondo-box-b1">
          <span class="rondo-seat-num">テーブル席</span>
          <span class="rondo-seat-info">2名 / ¥800</span>
        </div>
      </label>

      <label class="rondo-seat-label rondo-seat-b2">
        <input type="radio" name="seat_id" value="B-2" class="rondo-seat-radio">
        <div class="rondo-box-b2">
          <span class="rondo-seat-num">テーブル席</span>
          <span class="rondo-seat-info">4名 / ¥1,200</span>
        </div>
      </label>

      <label class="rondo-seat-label rondo-seat-b3">
        <input type="radio" name="seat_id" value="B-3" class="rondo-seat-radio">
        <div class="rondo-box-b3">
          <span class="rondo-seat-num">テーブル席</span>
          <span class="rondo-seat-info">2名 / ¥800</span>
        </div>
      </label>

      <label class="rondo-seat-label rondo-seat-b4">
        <input type="radio" name="seat_id" value="B-4" class="rondo-seat-radio">
        <div class="rondo-box-b4">
          <span class="rondo-seat-num">テーブル席</span>
          <span class="rondo-seat-info">4名 / ¥1,200</span>
        </div>
      </label>

      <label class="rondo-seat-label rondo-seat-a1">
        <input type="radio" name="seat_id" value="A-1" class="rondo-seat-radio">
        <div class="rondo-box-a1">
          <span class="rondo-seat-num">A-1</span>
          <span class="rondo-seat-info">¥500</span>
        </div>
      </label>

      <label class="rondo-seat-label rondo-seat-a2">
        <input type="radio" name="seat_id" value="A-2" class="rondo-seat-radio">
        <div class="rondo-box-a2">
          <span class="rondo-seat-num">A-2</span>
          <span class="rondo-seat-info">¥500</span>
        </div>
      </label>

      <label class="rondo-seat-label rondo-seat-a3">
        <input type="radio" name="seat_id" value="A-3" class="rondo-seat-radio">
        <div class="rondo-box-a3">
          <span class="rondo-seat-num">A-3</span>
          <span class="rondo-seat-info">¥500</span>
        </div>
      </label>

      <label class="rondo-seat-label rondo-seat-a4">
        <input type="radio" name="seat_id" value="A-4" class="rondo-seat-radio">
        <div class="rondo-box-a4">
          <span class="rondo-seat-num">A-4</span>
          <span class="rondo-seat-info">¥500</span>
        </div>
      </label>

      <label class="rondo-seat-label rondo-seat-a5">
        <input type="radio" name="seat_id" value="A-5" class="rondo-seat-radio">
        <div class="rondo-box-a5">
          <span class="rondo-seat-num">A-5</span>
          <span class="rondo-seat-info">¥500</span>
        </div>
      </label>

    </div>

    <div class="rondo-booking-area">
      <button type="submit" class="rondo-btn-booking">選択した席で予約を進める</button>
    </div>

  </form>
</div>
