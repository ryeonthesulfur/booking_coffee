<% content_for :store_css do %>
  <%= stylesheet_link_tag "store_floor_1" %>
<% end %>

<div class="floor-map-container">
  <% if confirm_mode %>
    <div class="floor-title">カフェ・ロンド - 座席確認</div>
  <% else %>
    <div class="floor-title">カフェ・ロンド - 座席選択</div>
  <% end %>

<% unless confirm_mode %>
  <div class="floor-subtitle">ご希望の座席をタップして予約に進んでください。</div>
<% end %>

  <div class="legend-area">
    <div class="legend-item">
      <div style="width: 16px; height: 16px; background: #fff; border: 1px solid #b5b4b1; border-radius: 4px;"></div>
      <span>空席</span>
    </div>
    <div class="legend-item">
      <div style="width: 16px; height: 16px; background: #78350f; border-radius: 4px;"></div>
      <span>選択中</span>
    </div>
    <div class="legend-item">
      <div style="width: 16px; height: 16px; background: #d6d3d1; border-radius: 4px;"></div>
      <span>予約済み</span>
    </div>
  </div>


    <div class="rondo-floor-plan">
      <div class="rondo-inner-floor"></div>

      <div class="floor-object floor-object-counter rondo-counter-top">カウンター席</div>
      <div class="floor-object floor-object-reception rondo-reception">受付</div>
      <div class="floor-object floor-object-entrance rondo-entrance">入り口</div>
      <div class="floor-object floor-object-wc rondo-wc">W.C.</div>

      <% reserved = @reserved_seat_numbers&.include?('C-1') %>
      <label class="seat-label rondo-seat-c1 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="C-1" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box">
          <span class="seat-num">テラス席</span>
          <span class="seat-info">C-1 / 4名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('C-2') %>
      <label class="seat-label rondo-seat-c2 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="C-2" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box">
          <span class="seat-num">テラス席</span>
          <span class="seat-info">C-2 / 4名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('B-1') %>
      <label class="seat-label rondo-seat-b1 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="B-1" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box">
          <span class="seat-num">テーブル席</span>
          <span class="seat-info">B-1 / 4名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('B-2') %>
      <label class="seat-label rondo-seat-b2 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="B-2" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box">
          <span class="seat-num">テーブル席</span>
          <span class="seat-info">B-2 / 4名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('B-3') %>
      <label class="seat-label rondo-seat-b3 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="B-3" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box">
          <span class="seat-num">テーブル席</span>
          <span class="seat-info">B-3 / 4名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('B-4') %>
      <label class="seat-label rondo-seat-b4 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="B-4" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box">
          <span class="seat-num">テーブル席</span>
          <span class="seat-info">B-4 / 4名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('A-1') %>
      <label class="seat-label rondo-seat-a1 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="A-1" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box">
          <span class="seat-num">A-1</span>
          <span class="seat-info">1名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('A-2') %>
      <label class="seat-label rondo-seat-a2 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="A-2" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box">
          <span class="seat-num">A-2</span>
          <span class="seat-info">1名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('A-3') %>
      <label class="seat-label rondo-seat-a3 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="A-3" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box">
          <span class="seat-num">A-3</span>
          <span class="seat-info">1名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('A-4') %>
      <label class="seat-label rondo-seat-a4 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="A-4" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box">
          <span class="seat-num">A-4</span>
          <span class="seat-info">1名</span>
        </div>
      </label>

      <% reserved = @reserved_seat_numbers&.include?('A-5') %>
      <label class="seat-label rondo-seat-a5 <%= 'disabled' if reserved %>">
        <input type="radio" name="seat_id" value="A-5" class="seat-radio" <%= 'disabled' if reserved %>>
        <div class="seat-box">
          <span class="seat-num">A-5</span>
          <span class="seat-info">1名</span>
        </div>
      </label>

    </div>

<% unless confirm_mode %>
    <div class="booking-action-area">
      <button type="button" data-store-id="<%= @store.id %>" class="btn-booking">選択した席で予約を進める</button>
    </div>
<% end %>

</div>
