<div class="store-hero" style="background-image: url('<%= @store.image_url %>');">
  <div class="store-hero__overlay">
    <div class="store-hero__inner">
      <%= link_to "← 店舗一覧に戻る", root_path, class: "store-hero__back" %>
      <div class="store-hero__badge-row">
        <% if @store.smoking %>
          <span class="store-hero__smoking store-hero__smoking--yes">喫煙可</span>
        <% else %>
          <span class="store-hero__smoking store-hero__smoking--non">禁煙</span>
        <% end %>
      </div>
      <h1 class="store-hero__name"><%= @store.name %></h1>
    </div>
  </div>
</div>

<main class="detail-main">
  <div class="detail-inner">
    <section class="detail-section">
      <h2 class="detail-section__heading">ご利用可能な席タイプ</h2>
      <div class="seat-type-grid">
        <% @seats_summary.each do |type, count| %>
          <div class="seat-type-card">
            <span class="seat-type-card__name"><%= type %></span>
            <span class="seat-type-card__count"><%= count %>席</span>
          </div>
        <% end %>
      </div>
    </section>
  </div>
</main>


<% if @store.name == "蔵前喫茶店" %>
  <%= render "stores/kuramae_floor" %>
<% elsif @store.name == "カフェ・ロンド" %>
  <%= render "stores/rondo_floor" %>
<% elsif @store.name == "喫茶むすび" %>
  <%= render "stores/musubi_floor" %>
<% end %>
